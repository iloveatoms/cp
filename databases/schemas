CREATE TABLE user (
    userid INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    email TEXT,
    phone TEXT,
    aadhar INTEGER NOT NULL,
    age INTEGER DEFAULT 0,
    followers INTEGER DEFAULT 0,
    following INTEGER DEFAULT 0,
    credits INTEGER DEFAULT 0,
    dateOfCreation INTEGER,
    profileUrl text,
    bio text,
    meta TEXT,
    sessionid TEXT
);

CREATE TABLE post (
    postid INTEGER PRIMARY KEY,
    userid INTEGER,
    dateOfCreation INTEGER,
    title TEXT,
    text TEXT,
    imageUrl TEXT,
    meta TEXT,
    likes INTEGER,
    dislikes INTEGER,
    credits INTEGER,
    FOREIGN KEY (userid) REFERENCES user(userid)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

CREATE TABLE likes (
    userid INTEGER NOT NULL REFERENCES user(userid)
        ON UPDATE CASCADE ON DELETE CASCADE,
    postid INTEGER NOT NULL REFERENCES post(postid)
        ON UPDATE CASCADE ON DELETE CASCADE,
    liked BOOLEAN NOT NULL DEFAULT 0,
    disliked BOOLEAN NOT NULL DEFAULT 0,
    PRIMARY KEY (userid, postid),
    CONSTRAINT check_single_action CHECK (liked + disliked <= 1)
);


-- likes TRIGGERS --

-- INSERT
CREATE TRIGGER likes_after_insert
AFTER INSERT ON likes
BEGIN
    UPDATE post
    SET likes = likes + NEW.liked,
        dislikes = dislikes + NEW.disliked
    WHERE postid = NEW.postid;
END;

-- UPDATE
CREATE TRIGGER likes_after_update
AFTER UPDATE OF liked, disliked ON likes
BEGIN
    UPDATE post
    SET likes = likes + (NEW.liked - OLD.liked),
        dislikes = dislikes + (NEW.disliked - OLD.disliked)
    WHERE postid = NEW.postid;
END;

-- DELETE
CREATE TRIGGER likes_after_delete
AFTER DELETE ON likes
BEGIN
    UPDATE post
    SET likes = likes - OLD.liked,
        dislikes = dislikes - OLD.disliked
    WHERE postid = OLD.postid;
END;



-- CREDITS
CREATE TRIGGER update_user_credits_after_post_update
AFTER UPDATE OF likes, dislikes ON post
BEGIN
    UPDATE user
    SET credits =
        MIN(
            10,
            MAX(
                1,
                ROUND(
                    1 + 9.0 *
                    (
                        LOG(
                            1 + (
                                SELECT COALESCE(
                                    MAX(SUM(likes - dislikes*0.8), 0),
                                    0
                                )
                                FROM post
                                WHERE post.userid = user.userid
                            )
                        )
                        /
                        LOG(1 + (SELECT COUNT(*) FROM user))
                    )
                )
            )
        )
    WHERE user.userid = NEW.userid;
END;
